# Base de datos Postgres (Supabase, Neon o local)
DATABASE_URL=postgres://usuario:clave@host:5432/vitalic

# Secreto para firmar la sesión (mínimo 32 caracteres aleatorios)
AUTH_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio

# Usuarios iniciales (se crean con `npm run db:seed`)
SEED_USERS=luis@crezcamosonline.com:Luis:cambiar-clave,paula@crezcamosonline.com:Paula:cambiar-clave

# Clave de la API de Claude para leer fotos de facturas
ANTHROPIC_API_KEY=
